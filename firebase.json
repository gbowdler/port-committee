{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      ".git/**",
      ".claude/**",
      ".github/**",
      "**/node_modules/**",
      "source-assets/**",
      "**/*.md",
      "server.js",
      "package.json",
      "storage.rules",
      "firestore.rules"
    ],
    "headers": [
      {
        "source": "videos/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800" }
        ]
      }
    ]
  }
}
